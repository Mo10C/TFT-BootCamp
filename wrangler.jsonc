{
  // ログイン式リーダーボード用 Worker（既存の tft-riot-proxy とは別デプロイ）
  // デプロイ: npx wrangler deploy
  "name": "mcc-login-board",
  "main": "worker.js",
  "compatibility_date": "2026-07-01",

  // 秘密情報はダッシュボード or CLI で設定（このファイルには書かない）:
  //   npx wrangler secret put RIOT_API_KEY
  //   npx wrangler secret put DISCORD_CLIENT_ID
  //   npx wrangler secret put DISCORD_CLIENT_SECRET
  //   npx wrangler secret put DISCORD_BOT_TOKEN
  //   npx wrangler secret put CRON_KEY          （/collect の手動実行用・任意）
  // Cron は2本（どちらもUTC表記。Cloudflareの入力欄はUTCです）
  //   45 14 * * *  → 23:45 JST  LPの一斉集計
  //    0  0 * * *  →  9:00 JST  きょうの予定をDiscordの談話室へ
  "triggers": { "crons": ["45 14 * * *", "0 0 * * *"] },

  "vars": {
    // クラウドハッシュテイル校サーバーのID（Discordの開発者モードでコピー）
    "DISCORD_GUILD_ID": "",
    // ログイン後の戻り先として許可するオリジン（カンマ区切り・推奨設定）
    "RETURN_ORIGINS": "https://mo10c.github.io,http://localhost:8000",
    // LP一斉集計に必要（Firestore REST 用。どちらも公開情報）
    "FIREBASE_PROJECT_ID": "tft-leaderboard-f6897",
    "FIREBASE_API_KEY": "AIzaSyCyZ7IbKh02V8fvILTCDTgLPKRuoNFS78Y",
    "RIOT_PLATFORM": "jp1",
    // ランクアップのお祝いを投げるチャンネルID（談話室）。空なら投稿しない
    "DISCORD_ANNOUNCE_CHANNEL_ID": "",
    // 予定表の当日通知を投げるチャンネルID（連絡事項）
    "DISCORD_SCHEDULE_CHANNEL_ID": "1540780799564062720"
  }
}
